{% if algorithm == "ppo" %}
import gymnax
import jax
import matplotlib.pyplot as plt

from rl_agents.ppo import PPOAgent
from rl_components.gymnax_bridge import make_gymnax_env
from rl_components.loop import run
from rl_components.types import PPOConfig

GAMMA = 0.99


def main():
    config = PPOConfig(
        ENV_NAME="{{ env_name }}",
        TOTAL_TIMESTEPS=500_000,
        SEED=42,
    )
    raw_env, env_params = gymnax.make(config.ENV_NAME)
    env = make_gymnax_env(raw_env)
    agent = PPOAgent(config)
    train_fn = jax.jit(
        lambda key: run(
            agent,
            env,
            key,
            steps=config.TOTAL_TIMESTEPS,
            gamma=GAMMA,
            env_params=env_params,
        )
    )

    rng = jax.random.PRNGKey(config.SEED)
    _, metrics = train_fn(rng)
    returns = metrics["loop/episode_return"][metrics["loop/episode_end"]]
    plt.plot(returns)
    plt.xlabel("Episode")
    plt.ylabel("Episode Return")
    plt.title("{{ project_name }} — PPO on {{ env_name }}")
    plt.savefig("results.png")
    print(f"Final mean return: {returns[-1]:.2f}")
