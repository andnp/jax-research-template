"""{{ description }}"""
{% if algorithm == "ppo" %}
import gymnax
import gymnax.wrappers
import jax
import matplotlib.pyplot as plt

from rl_agents.ppo import make_train
from rl_components.types import PPOConfig


def main():
    config = PPOConfig(
        ENV_NAME="{{ env_name }}",
        TOTAL_TIMESTEPS=500_000,
        SEED=42,
    )
    env, env_params = gymnax.make(config.ENV_NAME)
    env = gymnax.wrappers.LogWrapper(env)
    train_fn = make_train(config, env=env, env_params=env_params)
    train_fn = jax.jit(train_fn)

    rng = jax.random.PRNGKey(config.SEED)
    result = train_fn(rng)

    returns = result["metrics"]["returned_episode_returns"]
    plt.plot(returns)
    plt.xlabel("Update")
    plt.ylabel("Episode Return")
    plt.title("{{ project_name }} — PPO on {{ env_name }}")
    plt.savefig("results.png")
    print(f"Final mean return: {returns[-1]:.2f}")
{% elif algorithm == "dqn" %}
import gymnax
import jax

from rl_agents.dqn import DQNAgent, DQNConfig
from rl_components.gymnax_bridge import make_gymnax_env
from rl_components.loop import run

GAMMA = 0.99


def main():
    config = DQNConfig(
        ENV_NAME="{{ env_name }}",
        TOTAL_TIMESTEPS=200_000,
        SEED=42,
    )
    raw_env, env_params = gymnax.make(config.ENV_NAME)
    env = make_gymnax_env(raw_env)
    agent = DQNAgent(config)
    train_fn = jax.jit(
        lambda key: run(
            agent,
            env,
            key,
            steps=config.TOTAL_TIMESTEPS,
            gamma=GAMMA,
            env_params=env_params,
        )
    )

    rng = jax.random.PRNGKey(config.SEED)
    _, metrics = train_fn(rng)
    returns = metrics["loop/episode_return"][metrics["loop/episode_end"]]
    print(f"Final mean return: {returns[-1]:.2f}")
